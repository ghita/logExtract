# .gitignore for typical C#/.NET projects
# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# NuGet packages
*.nupkg
# The packages folder can be ignored if not using PackageReference
packages/
# Uncomment if using NuGet.exe
# nuget.exe

# Dotnet CLI
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlh
*.tli
*.tmp
*.log
*.vspscc
*.vssscc
*.vsconfig

# Others
_ReSharper*/
*.[Rr]e[Ss]harper*
*.DotSettings.user

# Windows image file caches
Thumbs.db

# Folder config file
Desktop.ini

# VS Code settings
.vscode/

# DotCover
*.dotCover

# Test results
TestResults/

# NCrunch
*.ncrunch*
_NCrunch_*

# MSTest test results
*.trx
*.VisualState.xml

# Build logs
*.log

# Backup & report files
*.bak
*.report

# Publish folder
publish/
